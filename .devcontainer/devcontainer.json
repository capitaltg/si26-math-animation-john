{
  "name": "si26-math-animation",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.dev.yml",
    "docker-compose.override.yml"
  ],
  "service": "backend",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  // Bring up the whole dev stack so postgres/redis are available inside the
  // devcontainer network. Frontend-dev is under the "dev" profile.
  "runServices": ["backend", "postgres", "redis", "frontend-dev"],

  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite dev)", "onAutoForward": "openPreview" },
    "8000": { "label": "Backend (FastAPI)",   "onAutoForward": "silent" }
  },

  "postAttachCommand": {
    "hint": "echo 'Dev stack up. Try: make help  |  make dev  |  make frontend  |  make down'"
  },

  // Docker-outside-of-Docker so `make` targets that shell out to
  // `docker compose ...` work from inside the devcontainer — the host
  // socket is mounted (see docker-compose.override.yml), and this feature
  // installs the CLI + Compose plugin.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": true,
      "installDockerBuildx": true,
      "installDockerComposeSwitch": true
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend/tests"],
        "editor.formatOnSave": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
