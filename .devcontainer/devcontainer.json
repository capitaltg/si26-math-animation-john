{
  "name": "si26-math-animation",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.dev.yml"
  ],
  "service": "backend",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",

  // Bring up the whole dev stack so postgres/redis are available inside the
  // devcontainer network. Frontend-dev is under the "dev" profile.
  "runServices": ["backend", "postgres", "redis", "frontend-dev"],

  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite dev)", "onAutoForward": "openPreview" },
    "8000": { "label": "Backend (FastAPI)",  "onAutoForward": "silent" }
  },

  // Devcontainer inherits Dockerfile.backend's HEALTHCHECK, which is fine
  // for the attached service. Give it a moment before showing shell.
  "postAttachCommand": {
    "hint": "echo 'Dev stack up. Try: make help  |  make dev  |  make frontend  |  make down'"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend/tests"],
        "editor.formatOnSave": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  // Point VS Code / Cursor tasks at the Makefile so Command Palette →
  // "Tasks: Run Task" → dev / frontend / down works without leaving the IDE.
  "features": {}
}
