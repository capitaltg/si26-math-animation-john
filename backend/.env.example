AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Prefer an AWS profile or role in production. If using static credentials locally:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Dev-only meta-template authoring system. Enable explicitly for a local demo.
META_TEMPLATES_ENABLED=false
META_CODEGEN_ENABLED=false
META_APPROVAL_ENABLED=false
META_DYNAMIC_CLASSIFIER_ENABLED=false
META_REVIEWER_TOKEN=
FINGERPRINT_OBSERVATION_THRESHOLD=5

# When true (the default), a teacher approving their own draft publishes it to
# every session on this box, using only their session cookie as authorization.
# Set false to keep teacher approvals private and require the token-gated
# POST /meta/versions/{id}/promote to share one.
# META_TEACHER_PUBLISH_SHARED=true
