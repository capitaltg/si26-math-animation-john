# Copy to `.env` in the same directory as docker-compose.yml. `.env` is gitignored.

# --- AWS Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
# AWS_SESSION_TOKEN=optional_for_temp_creds
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# --- Bedrock rate-limit / cost guards ---
# Kill switch: set to 1 (then `docker compose restart backend meta-worker`) to
# halt all Bedrock calls without redeploying.
BEDROCK_DISABLED=0
# Layer 3 — global daily call ceiling. 429 after this many calls per UTC day.
BEDROCK_DAILY_CALL_CAP=2000
# Layer 2 — per-client-IP hourly ceiling. 429 after this many calls per IP.
BEDROCK_PER_IP_HOURLY_CAP=40

# --- Meta-template subsystem toggles ---
META_TEMPLATES_ENABLED=false
META_CODEGEN_ENABLED=false
META_APPROVAL_ENABLED=false
META_DYNAMIC_CLASSIFIER_ENABLED=false
# META_REVIEWER_TOKEN=set_if_META_APPROVAL_ENABLED

# --- Sessions ---
# Default false so the shipped HTTP :80 front door works. Flip to true ONLY
# when you have TLS in front (Caddy / Traefik / hosted LB) — the Secure flag
# prevents the browser from sending the cookie over plain HTTP, which will
# silently break session continuity on non-localhost deployments.
SESSION_COOKIE_SECURE=false

# --- Infrastructure ---
POSTGRES_PASSWORD=change_me_to_a_long_random_string
# PUBLIC_HTTP_PORT=80
