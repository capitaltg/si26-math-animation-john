# Copy to `.env` in the same directory as docker-compose.yml. `.env` is gitignored.

# --- AWS Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
# AWS_SESSION_TOKEN=optional_for_temp_creds
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# --- Bedrock rate-limit / cost guards ---
# Kill switch: set to 1 (then run `make restart`) to halt all Bedrock calls
# without redeploying. `docker compose restart` alone will NOT reread .env —
# env vars are baked in at container create time, so a plain restart leaves
# the old value active. `make restart` uses `up -d --force-recreate` which
# actually recreates the container with the new env.
BEDROCK_DISABLED=0
# Layer 3 — global daily call ceiling. 429 after this many calls per UTC day.
BEDROCK_DAILY_CALL_CAP=2000
# Layer 2 — per-client-IP hourly ceiling. 429 after this many calls per IP.
BEDROCK_PER_IP_HOURLY_CAP=40

# --- Meta-template subsystem toggles ---
META_TEMPLATES_ENABLED=false
META_CODEGEN_ENABLED=false
META_APPROVAL_ENABLED=false
META_DYNAMIC_CLASSIFIER_ENABLED=false
# META_REVIEWER_TOKEN=set_if_META_APPROVAL_ENABLED

# --- Sessions ---
# Default false so the shipped HTTP :80 front door works. Flip to true ONLY
# when you have TLS in front (Caddy / Traefik / hosted LB) — the Secure flag
# prevents the browser from sending the cookie over plain HTTP, which will
# silently break session continuity on non-localhost deployments.
SESSION_COOKIE_SECURE=false

# --- Media volume ---
# Global size cap across all sessions (bytes). 0 = unlimited (dev). Sweep
# runs on startup and every MEDIA_SWEEP_INTERVAL_SECONDS. Oldest renders
# evicted first once total > cap.
MEDIA_MAX_BYTES=5368709120        # 5 GiB
MEDIA_SWEEP_INTERVAL_SECONDS=300

# --- CORS ---
# Comma-separated origin list. Same-origin via nginx means this is only
# useful for local dev against Vite; narrow in prod.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Bedrock mocking (dev / CI only) ---
# When 1, the backend returns canned tool responses instead of calling
# AWS. Set for CI smoke runs where no real AWS creds should ship.
# MATH_ANIM_MOCK_BEDROCK=0

# --- Infrastructure ---
POSTGRES_PASSWORD=change_me_to_a_long_random_string
# PUBLIC_HTTP_PORT=80

# --- TLS overlay (only used with docker-compose.tls.yml) ---
# Public hostname Caddy will request a Let's Encrypt cert for. Must resolve
# to this host, and ports 80+443 must be reachable from the internet.
# DOMAIN=demo.example.com
# TLS_EMAIL=you@example.com
